# Copiar a .env y completar. NO commitear .env.

# --- Base de la tienda (pedidos, usuarios, zonas, contenido) ---
DB_TIENDA_HOST=167.250.5.60
DB_TIENDA_PORT=3306
DB_TIENDA_USER=iebbbhrt_operador
DB_TIENDA_PASSWORD=xxxxxxxx
DB_TIENDA_NAME=iebbbhrt_prueba_paginaweb

# --- Base del ERP (catálogo de productos: mprimas, categorias, Stock) ---
DB_ERP_HOST=167.250.5.60
DB_ERP_PORT=3306
DB_ERP_USER=iebbbhrt_operador
DB_ERP_PASSWORD=xxxxxxxx
DB_ERP_NAME=iebbbhrt_masorganicos

# Clave para firmar las cookies de sesión (cambiar por algo largo y aleatorio)
SECRET_KEY=cambiar-esto-por-una-cadena-larga-y-secreta

# De dónde se sirven las fotos de producto (<Codigo>.jpg)
#   local:  /img            (se monta la carpeta _migracion/fotos)
#   prod:   https://masorganicos.com.ar/claude2026/assets/img
IMG_BASE_URL=/img

# Modo: development / production
ENTORNO=development

# Escritura de pedidos reales. En 0 el checkout simula y NO toca la base.
PERMITIR_ESCRIBIR_PEDIDOS=0
